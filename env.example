# Create a separate Clerk application or explicitly configure its allowed local origin.
# UI origin: http://localhost:4001 (allow this origin in Clerk).
# Do not commit real credentials. Use .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# Fixed server-side loopback upstream. No credentials, path, query or fragment.
VAULT_API_ORIGIN=http://127.0.0.1:4000
