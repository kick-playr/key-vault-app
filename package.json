{
  "name": "@kick-playr/key-vault-app",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname localhost -p 4001",
    "start:dev": "npm run dev",
    "build": "next build",
    "start": "next start --hostname localhost -p 4001",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx",
    "maint:update": "ncu -u -t minor && npm install && npm audit fix --audit-level moderate && npm install"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.23",
    "@heroicons/react": "^2.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
